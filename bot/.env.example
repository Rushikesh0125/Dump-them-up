# Your testnet account. Its full-access key must be in ~/.near-credentials/testnet/<account>.json
# (created by `near login` / near-cli-rs "legacy keychain"), or paste it below.
MASTER_ACCOUNT=yourname.testnet
MASTER_PRIVATE_KEY=
# RPC endpoint (the default public endpoint is rate limited)
NEAR_RPC=https://rpc.testnet.fastnear.com
# Length of one count (epoch) in seconds. The spec uses 3600; a shorter count is better for demos.
COUNT_SECONDS=900
